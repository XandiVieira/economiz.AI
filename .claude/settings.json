{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git *)",
      "Bash(./mvnw *)",
      "Bash(mvnw *)",
      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(gh *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(ls *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(curl http://localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl http://127.0.0.1:*)",
      "PowerShell(Get-*)",
      "PowerShell(Test-Path *)",
      "PowerShell(Select-Object *)",
      "PowerShell(Select-String *)",
      "PowerShell(Set-Location *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git config --global *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(scp *)",
      "Bash(ssh *)",
      "Bash(nc *)",
      "PowerShell(Remove-Item -Recurse -Force *)",
      "PowerShell(git config --global *)",
      "PowerShell(Format-Volume *)",
      "Read(.env)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  }
}
